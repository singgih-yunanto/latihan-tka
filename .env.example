# Public origin of the app. REQUIRED on a server, otherwise Server Actions are
# rejected when the app is reached through a reverse proxy.
# Example: https://203.0.113.10
APP_ORIGIN=

# Keeps Server Actions working across builds and restarts, so a page that was
# open during a deploy can still save answers. Must be set when building.
# Generate once with:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Timezone for every date the app displays. Defaults to Asia/Jakarta (WIB).
# Use Asia/Makassar for WITA or Asia/Jayapura for WIT.
NEXT_PUBLIC_TKA_TIMEZONE=

# Location of the SQLite file. Required in production.
# Development default: ./data/tka.db  |  Server: /var/lib/tka/tka.db
TKA_DB_PATH=

# Where backups are written (used by npm run db:backup)
TKA_BACKUP_DIR=

# How many backup copies to keep
TKA_BACKUP_KEEP=14
